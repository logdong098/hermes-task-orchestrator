# Coordinator：请在实际部署时替换为随机长字符串。
HERMES_DATABASE_PATH=data/hermes.db
HERMES_DIRECTOR_API_KEY=replace-with-a-long-random-director-key
HERMES_WORKER_SHARED_SECRET=replace-with-a-long-random-worker-secret
# 可选：设置后只接受映射中的 Worker，并覆盖共享密钥回退模式。
# HERMES_WORKER_SECRETS_JSON={"macbook-worker-01":"replace-with-worker-specific-secret"}
HERMES_WORKER_STALE_SECONDS=45
HERMES_TASK_LEASE_SECONDS=30
HERMES_HMAC_MAX_CLOCK_SKEW_SECONDS=300
HERMES_DEFAULT_TASK_TIMEOUT_SECONDS=900
HERMES_MAX_TASK_TIMEOUT_SECONDS=7200
HERMES_DEFAULT_MAX_ATTEMPTS=2
HERMES_MAINTENANCE_INTERVAL_SECONDS=5

# Worker
HERMES_COORDINATOR_URL=http://127.0.0.1:8000
HERMES_WORKER_ID=macbook-worker-01
HERMES_WORKER_NAME=MacBook Worker 01
HERMES_WORKER_COMMAND=hermes chat -q {prompt}
HERMES_WORKER_ALLOWED_WORKDIR=/absolute/path/to/allowed/workspace
HERMES_WORKER_CONCURRENCY=1
HERMES_WORKER_TASK_TIMEOUT_SECONDS=900
HERMES_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
HERMES_WORKER_POLL_INTERVAL_SECONDS=2

# Telegram（不配置时无需启动 Telegram 进程）
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_ALLOWED_USER_IDS=123456789
HERMES_TELEGRAM_POLL_TIMEOUT_SECONDS=25
HERMES_TELEGRAM_NOTIFICATION_INTERVAL_SECONDS=3
HERMES_TELEGRAM_OFFSET_PATH=data/telegram.offset
