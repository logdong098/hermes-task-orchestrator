# Coordinator：请在实际部署时替换为随机长字符串。
HERMES_DATABASE_PATH=data/hermes.db
HERMES_DIRECTOR_API_KEY=replace-with-a-long-random-director-key
HERMES_WORKER_SHARED_SECRET=replace-with-a-long-random-worker-secret
# 可选：设置后只接受映射中的 Worker，并覆盖共享密钥回退模式。
# HERMES_WORKER_SECRETS_JSON={"macbook-worker-01":"replace-with-worker-specific-secret"}
HERMES_WORKER_STALE_SECONDS=45
# 长期无心跳后从活跃注册表剔除；必须大于 stale 阈值。
HERMES_WORKER_EVICTION_SECONDS=900
# 至少覆盖 4 个 Worker 心跳周期（默认心跳间隔为 10 秒）。
HERMES_TASK_LEASE_SECONDS=120
HERMES_HMAC_MAX_CLOCK_SKEW_SECONDS=300
HERMES_DEFAULT_TASK_TIMEOUT_SECONDS=900
HERMES_MAX_TASK_TIMEOUT_SECONDS=7200
HERMES_DEFAULT_MAX_ATTEMPTS=3
HERMES_MAINTENANCE_INTERVAL_SECONDS=5
# Gateway 远端结果对账窗口与重试间隔。
HERMES_RECONCILIATION_GRACE_SECONDS=3600
HERMES_RECONCILIATION_BACKOFF_SECONDS=5
# Coordinator 本地先生成执行计划；命令值必须是 argv 数组且包含 {prompt}。
HERMES_PLANNER_DEFAULT_AGENT=codex
HERMES_PLANNER_COMMANDS_JSON={"claude":["claude","--permission-mode","plan","-p","{prompt}"],"codex":["codex","exec","--sandbox","read-only","{prompt}"]}
HERMES_PLANNER_TIMEOUT_SECONDS=900
HERMES_PLANNER_POLL_INTERVAL_SECONDS=2
HERMES_PLANNER_LEASE_SECONDS=30
HERMES_PLANNER_MAX_ATTEMPTS=2
HERMES_PLANNER_MAX_OUTPUT_BYTES=2000000

# Unified Worker：一个进程统一处理 Hermes、Codex 和 Claude Code。
HERMES_COORDINATOR_URL=http://127.0.0.1:8000
HERMES_WORKER_ID=macbook-worker-01
HERMES_WORKER_NAME=MacBook Worker 01
HERMES_WORKER_COMMAND=hermes chat -q {prompt}
# 未指定 execution_agent 时使用默认 Agent；-codex/-cc 可覆盖本次任务。
HERMES_WORKER_DEFAULT_AGENT=hermes
# 命令值必须包含独立的 {prompt} 参数，不经过 shell 执行。
HERMES_WORKER_AGENTS_JSON={"codex":["codex","exec","{prompt}"],"claude-code":["claude","-p","{prompt}"]}
# 兼容旧部署也可使用 HERMES_AGENT_COMMANDS（格式相同）。
# Windows 上如果 Claude Code 由 npm 安装，请使用命令名；Worker 会先解析
# claude.cmd 的实际路径，再启动子进程。若需要 headless Claude Code：
# HERMES_AGENT_COMMANDS={"cc":["claude","-p","{prompt}","--dangerously-skip-permissions"]}
HERMES_WORKER_ALLOWED_WORKDIR=/absolute/path/to/allowed/workspace
HERMES_WORKER_CONCURRENCY=1
HERMES_WORKER_TASK_TIMEOUT_SECONDS=900
HERMES_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
HERMES_WORKER_POLL_INTERVAL_SECONDS=2

# Hermes Gateway（Unified Worker 的 Hermes 执行后端）
# Hermes API Server 默认监听 8642；这里填写 Worker 所在机器可访问的地址。
# 旧 gateway-worker 入口仍读取 HERMES_GATEWAY_WORKER_ID/NAME；新入口使用上面的 Worker ID/NAME。
HERMES_GATEWAY_WORKER_ID=hermes-gateway-worker-01
HERMES_GATEWAY_WORKER_NAME=Hermes Gateway Worker 01
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_GATEWAY_ID=local-hermes
# Coordinator 展示用的路由类型：local|remote|ssh|cloud。
HERMES_GATEWAY_KIND=local
# Gateway 全局 key（若服务端要求）；生产环境建议使用 profile keys。
HERMES_GATEWAY_TOKEN=
# 每个 Profile 独立 key，JSON key 必须与 HERMES_GATEWAY_PROFILES 中的名称一致。
HERMES_GATEWAY_PROFILE_KEYS_JSON={}
HERMES_GATEWAY_PROFILES=default
# 只有此 Profile 可以使用 HERMES_GATEWAY_TOKEN；其他 Profile 必须配置独立 key。
HERMES_GATEWAY_DEFAULT_PROFILE=default
# M1 Gateway route 固定执行 hermes；Worker 默认 Agent 由 HERMES_WORKER_DEFAULT_AGENT 控制。
HERMES_GATEWAY_DEFAULT_AGENT=hermes
HERMES_GATEWAY_WORKER_CONCURRENCY=1
HERMES_GATEWAY_TASK_TIMEOUT_SECONDS=900
HERMES_GATEWAY_HEARTBEAT_INTERVAL_SECONDS=10
HERMES_GATEWAY_WORKER_POLL_INTERVAL_SECONDS=2
HERMES_GATEWAY_POLL_INTERVAL_SECONDS=2
HERMES_GATEWAY_REQUEST_TIMEOUT_SECONDS=30
HERMES_GATEWAY_STOP_WAIT_SECONDS=30

# Telegram（不配置时无需启动 Telegram 进程）
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_ALLOWED_USER_IDS=123456789
HERMES_TELEGRAM_POLL_TIMEOUT_SECONDS=25
HERMES_TELEGRAM_NOTIFICATION_INTERVAL_SECONDS=3
HERMES_TELEGRAM_OFFSET_PATH=data/telegram.offset
